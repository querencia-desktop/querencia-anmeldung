[Unit]
Description=Querencia Anmeldung (greetd mit ReGreet)
Documentation=man:querencia-anmeldung(8) man:greetd(1)
After=systemd-user-sessions.service plymouth-quit-wait.service
After=getty@tty7.service
Conflicts=getty@tty7.service

[Service]
Type=simple
ExecStart=/usr/sbin/querencia-anmeldung
IgnoreSIGPIPE=no
SendSIGHUP=yes
TimeoutStopSec=30s
KeyringMode=shared
Restart=always
RestartSec=1
StartLimitBurst=5
StartLimitIntervalSec=30

[Install]
Alias=display-manager.service
