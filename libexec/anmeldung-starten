#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Befehl des Anmeldebildschirms (greetd default_session, Benutzer _greetd).
#
# Stellt die Sitzungsliste zusammen (sitzungen-auswahl: nur Querencia-
# und freigegebene Sitzungen, jede über die Sitzungshülle sitzung-starten),
# übernimmt Sprache (/etc/default/locale) und Tastaturbelegung
# (/etc/default/keyboard) des Systems und startet labwc ohne Menü und
# Tastenkürzel mit ReGreet als einzigem Programm. labwc endet, sobald
# ReGreet endet (-S); greetd startet dann die gewählte Sitzung.
#
# ReGreet liest Sitzungen aus XDG_DATA_DIRS, wenn die Variable gesetzt ist,
# und sonst aus dem eingebauten SESSION_DIRS (/run/querencia-anmeldung/
# wayland-sessions, von sitzungen-auswahl gefüllt). Deshalb läuft ReGreet
# ohne XDG_DATA_DIRS; GTK nimmt dann /usr/local/share:/usr/share.
#
# Die Dateien werden zeilenweise gelesen statt mit "." eingelesen: ein
# Tippfehler darin soll den Anmeldebildschirm nicht verhindern.

KONFIG=${QUERENCIA_ANMELDUNG_KONFIG:-/etc/querencia/greetd}
REGREET=${QUERENCIA_ANMELDUNG_REGREET:-/usr/libexec/querencia-anmeldung/regreet}
AUSWAHL=${QUERENCIA_ANMELDUNG_AUSWAHL:-/usr/libexec/querencia-anmeldung/sitzungen-auswahl}

# wert <zeile>: Wert hinter dem ersten "=", ohne umschließende Anführungszeichen
wert() {
    v=${1#*=}
    case $v in
    \"*\") v=${v#\"}; v=${v%\"} ;;
    \'*\') v=${v#\'}; v=${v%\'} ;;
    esac
    printf '%s' "$v"
}

if [ -r /etc/default/locale ]; then
    while IFS= read -r zeile || [ -n "$zeile" ]; do
        case $zeile in
        LANG=* | LANGUAGE=* | LC_[A-Z]*=*)
            name=${zeile%%=*}
            case $name in *[!A-Z_]*) continue ;; esac
            export "$name=$(wert "$zeile")" ;;
        esac
    done </etc/default/locale
fi

# Sitzungsliste erst nach der Sprache: sitzungen-auswahl übernimmt die
# Sitzungsnamen in der Systemsprache (Name[de] usw. der Sitzungsdateien).
# Meldungen ins Journal des Dienstes (stderr von greetd); ein Fehler hier
# lässt ReGreet mit der leeren oder vorigen Liste starten.
"$AUSWAHL" >&2 || echo "anmeldung-starten: keine Sitzung angeboten (siehe sitzungen-auswahl)" >&2

if [ -r /etc/default/keyboard ]; then
    while IFS= read -r zeile || [ -n "$zeile" ]; do
        case $zeile in
        XKBMODEL=*) v=$(wert "$zeile"); [ -z "$v" ] || export XKB_DEFAULT_MODEL="$v" ;;
        XKBLAYOUT=*) v=$(wert "$zeile"); [ -z "$v" ] || export XKB_DEFAULT_LAYOUT="$v" ;;
        XKBVARIANT=*) v=$(wert "$zeile"); [ -z "$v" ] || export XKB_DEFAULT_VARIANT="$v" ;;
        XKBOPTIONS=*) v=$(wert "$zeile"); [ -z "$v" ] || export XKB_DEFAULT_OPTIONS="$v" ;;
        esac
    done </etc/default/keyboard
fi

# Info-Zeile: Der Grußtext bekommt die Ausgabe von Querencia Desktop
# (z. B. „Querencia Desktop Alpha 2.1“) aus der Versionsdatei des
# Metapakets: VERSION aus /usr/share/querencia/release, sonst die erste
# Zeile von /usr/share/querencia/version. Fehlen beide, bleibt der Grußtext
# unverändert und ReGreet liest regreet.toml direkt. Sonst liest ReGreet
# eine Kopie in /run/querencia-anmeldung, in der nur greeting_msg ergänzt
# ist. Die beiden Variablen der Pfade sind nur für tests/konfig-pruefen.sh.
RELEASE=${QUERENCIA_ANMELDUNG_RELEASE:-/usr/share/querencia/release}
VERSION=${QUERENCIA_ANMELDUNG_VERSION:-/usr/share/querencia/version}
LAUFZEIT=${QUERENCIA_ANMELDUNG_LAUFZEIT:-/run/querencia-anmeldung}
ausgabe=
if [ -r "$RELEASE" ]; then
    while IFS= read -r zeile || [ -n "$zeile" ]; do
        case $zeile in VERSION=*) ausgabe=$(wert "$zeile") ;; esac
    done <"$RELEASE"
fi
if [ -z "$ausgabe" ] && [ -r "$VERSION" ]; then
    IFS= read -r ausgabe <"$VERSION" || [ -n "$ausgabe" ]
fi
# nur druckbare Zeichen, Rand ohne Leerraum, für TOML \ und " maskiert
ausgabe=$(printf '%s' "$ausgabe" | tr -d '[:cntrl:]' |
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/[\\"]/\\&/g')
REGREET_KONFIG=
rm -f "$LAUFZEIT/regreet.toml"
if [ -n "$ausgabe" ] && [ -r "$KONFIG/regreet.toml" ] &&
    sed -e "s/^\([[:space:]]*greeting_msg[[:space:]]*=[[:space:]]*\"[^\"]*\)\"[[:space:]]*\$/\1 $(printf '%s' "$ausgabe" | sed -e 's/[\\&/]/\\&/g')\"/" \
        "$KONFIG/regreet.toml" >"$LAUFZEIT/regreet.toml" 2>/dev/null; then
    REGREET_KONFIG=" --config $LAUFZEIT/regreet.toml"
else
    rm -f "$LAUFZEIT/regreet.toml"
fi

unset XDG_DATA_DIRS
exec /usr/bin/dbus-run-session -- /usr/bin/labwc -C "$KONFIG/labwc" -S "/usr/bin/env -u XDG_DATA_DIRS $REGREET$REGREET_KONFIG"
